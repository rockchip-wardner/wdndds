# Default: ignore .so. We override this for the bundled native payloads
# under src/wdndds/dds/_native/ via the explicit `!` rules at the bottom
# — setuptools doesn't auto-pick up compiled extensions, and the wheel
# needs them to ship.
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

.env
.venv
env/
venv/
ENV/

.pytest_cache/
