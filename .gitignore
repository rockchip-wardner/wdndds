# Default: ignore .so. We override this for the bundled native payloads
# under src/wdndds/dds/_native/ and native/lib/ via the explicit `!`
# rules at the bottom — setuptools doesn't auto-pick up compiled
# extensions, and the wheel needs them to ship.
*.so
