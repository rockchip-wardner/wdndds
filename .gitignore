# ---------------------------------------------------------------------------
# Re-included paths. Git's gitignore matcher is "last match wins" but a
# parent-directory ignore (the `lib/` rule above) suppresses everything
# underneath it — including later file-level `!` rules. So we MUST
# un-ignore `native/lib/` BEFORE any other rules are evaluated against
# it, by placing `!native/lib/` right after the `lib/` rule.
# ---------------------------------------------------------------------------

# Un-ignore the vendored FastDDS directory (parent-dir `lib/` above would
# otherwise swallow the whole subtree; the `!` here re-includes the
# directory itself so subsequent file-level `!` rules can take effect).
!native/lib/

# v0.4 wheel (legacy): bundles FastDDS 2.6 + WDnddsString SWIG via _native/.
!src/wdndds/dds/_native/fastdds/_fastdds_python.so
!src/wdndds/dds/_native/_fastdds_python.so
!src/wdndds/dds/_native/_wdndds_string.so
!src/wdndds/dds/_native/lib/

# v0.5 wheel: cshim + IDL output land in _native/ at pip install time
# (source-compiled by _build.py from cshim_src/wdndds_cshim.cpp +
# idl/compute.idl). Whitelist here so MANIFEST includes them in the
# wheel; the .so files themselves are NEVER in git — built fresh per
# install from our source.
!src/wdndds/dds/_native/libwdndds_cshim.so
!src/wdndds/dds/_native/libwdndds_idl.so

# FastDDS 3.6 official pre-built artifacts — vendored as-is (NOT our
# source code, just the published binaries from /userdata/src/Fast-DDS
# + /userdata/src/deps/fastcdr). These are the third-party libs that
# wdndds cshim links against. Vendoring them saves every fresh
# checkout from doing the 5-10 minute colcon FastDDS build
# (`build_native.sh` only needed when changing platform or upgrading
# FastDDS). Our own build products (libwdndds_cshim.so /
# libwdndds_idl.so) are NOT vendored — those are compiled from
# cshim_src/ and idl/ at pip install time.
!native/lib/libfastdds.so                                 # vendored official
!native/lib/libfastdds.so.3.6
!native/lib/libfastdds.so.3.6.2.0
!native/lib/libfastcdr.so                                 # vendored official
!native/lib/libfastcdr.so.2
!native/lib/libfastcdr.so.2.3.6
!native/lib/cmake/fastdds/                                # cmake config for find_package
!native/lib/cmake/fastcdr/
!native/include/fastdds/                                  # C++ headers (cmake needs them)
!native/include/fastcdr/
!native/bin/fastddsgen                                    # IDL→C++ generator (Java wrapper)
!native/share/fastddsgen/java/fastddsgen.jar              # the actual jar

# foonathan_memory 0.7.4 (eProsima memory.git vendor-1.4.1) —
# built from source, then statically linked into libfastdds.so
# so there's no runtime .so dep on libfoonathan_memory. Vendored
# here so libfastdds.so can be re-linked (e.g. via _build.py)
# without rebuilding foonathan first.
!native/lib/libfoonathan_memory-0.7.4.a                   # static archive (linker input)
!native/lib/foonathan_memory/                             # cmake configs (find_package entry)
!native/include/foonathan/                                # C++ headers (needed by libfastdds relink)
!native/share/foonathan_memory/                           # LICENSE + README
!native/share/foonathan_memory_vendor/                    # vendor cmake config (used by _build.py)

# Re-ignore wdndds source-compiled .so files (built from cshim_src/
# and idl/ at pip install time; NEVER in git). After the directory
# un-ignore above, these explicit ignores re-suppress just the
# wdndds-owned .so files while keeping the FastDDS ones tracked.
# These paths are absolute- (leading `/`) so they match only these
# exact files, never anything user-built.
/native/lib/libwdndds_cshim.so
/native/lib/libwdndds_idl.so

# Everything else under native/ stays gitignored — those are
# dev-only / debug / not-needed artifacts:
#   native/bin/fast-discovery-server* / fastdds / ros-discovery
#                             debug CLI tools (not used by build or runtime)
#   native/include/wdndds/    idl-generated headers (cmake uses the
#                              committed idl/ source dir instead)
#   native/share/             FastDDS XML schemas (debug static discovery)
#                             + FastDDS-Python packaging helpers
#   native/tools/             fasddsgen etcbuild/
src/wdndds/dds/_native/_build_tmp/

# v0.4 backup of cshim_src/ — superseded by the single-file
# v0.5 cshim_src/wdndds_cshim.cpp; never tracked.
cshim_src_v0.4_backup/

# fastddsgen artifact guard — if you accidentally run
# `fastddsgen -d idl idl/compute.idl` you get a stray `idl/idl/`
# subdir from the input's relative path under -d.
idl/idl/

src/wdndds/dds/_native/libwdndds_cshim.so
src/wdndds/dds/_native/libwdndds_idl.so
