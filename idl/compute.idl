// compute.idl — wdndds RPC-DDS interface for compute_worker
//
// One service per model. Worker registers the service; main process sends
// requests. The 5 actions are: info, load, infer, reset, shutdown.
//
// v0.7 string→sequence<octet> migration (方案B): all 11 string fields
// become sequence<octet> so heavy payloads (audio PCM, image bytes via
// base64, structured result JSON, etc.) aren't silently truncated by
// FastCDR's fixed_string<MAX>::assign cap (was 65535 for request.prompt,
// 255 default for reply-side 5 fields per AGENTS.md TODO). Bytes flow
// unchanged on the wire — sequence<octet> uses the same
// u32 LE length + payload CDR encoding as string<MAX> — so the only
// side effect is C++ API ergonomics in wdndds_cshim.cpp.

const string WDNDDS_SERVICE_TYPE_NAME = "wdndds::rpc::ComputeService";

const long WDNDDS_REQUEST_ACTION_INFO = 0;
const long WDNDDS_REQUEST_ACTION_LOAD = 1;
const long WDNDDS_REQUEST_ACTION_INFER = 2;
const long WDNDDS_REQUEST_ACTION_RESET = 3;
const long WDNDDS_REQUEST_ACTION_SHUTDOWN = 4;

const long WDNDDS_ATTACHMENT_KIND_TEXT = 0;
const long WDNDDS_ATTACHMENT_KIND_IMAGE = 1;
const long WDNDDS_ATTACHMENT_KIND_NDARRAY = 2;

const long WDNDDS_IMAGE_ENCODING_RAW = 0;     // local SHM transport
const long WDNDDS_IMAGE_ENCODING_JPEG = 1;    // over the wire (remote / lossy)
const long WDNDDS_IMAGE_ENCODING_PNG = 2;     // over the wire (lossless)

// One attached payload (image / text / ndarray blob).
// `kind` is one of WDNDDS_ATTACHMENT_KIND_*. `encoding` is only meaningful
// for IMAGE (RAW / JPEG / PNG). `bytes` carries the actual content.
struct ComputeAttachment {
    long kind;
    sequence<octet> mime_type;     // "image/jpeg" / "image/png" / "text/plain" / ...
    long encoding;        // one of WDNDDS_IMAGE_ENCODING_*
    long width;           // for IMAGE: pixel width (0 if unknown)
    long height;          // for IMAGE: pixel height (0 if unknown)
    long channels;        // for IMAGE: 3 / 4
    long row_stride;      // for IMAGE NDARRAY: bytes per row
    sequence<octet> bytes;
};

// Compute request — one action + generic payload.
struct ComputeRequest {
    long long request_id;            // matches request <-> reply
    long action;                     // WDNDDS_REQUEST_ACTION_*
    long long every_n;               // for INFER: sample-every-N frames
    sequence<octet> prompt;          // for INFER: LLM prompt (JSON envelope)
    sequence<octet> model_id;        // for INFO: reported by server
    long long npu_index;             // for INFO: reported by server
    sequence<ComputeAttachment> attachments;
};

// Compute reply — generic result envelope.
struct ComputeReply {
    long long request_id;            // echoes the request's id
    boolean ok;                      // true on success
    sequence<octet> error;            // when ok == false, the message

    long status;                     // not_loaded / loading / running / error
    sequence<octet> status_text;      // "running" / "error" / "shutting_down" / ...

    // INFER-only fields
    sequence<octet> text;
    sequence<octet> level;
    sequence<octet> tool_call;
    sequence<octet> bbox_json;        // [x1, y1, x2, y2] or empty
    sequence<octet> crop_b64;         // JPEG-cropped ROI from TargetDoc

    // LOAD-only fields
    double load_time_sec;
    long long loaded_at_unix;

    // INFO-only fields
    sequence<octet> model;
    sequence<octet> model_dir;
    long long npu_index_info;
    sequence<octet> init_error;
    boolean rkai_available;
};
